{
  "manifest_version": 3,
  "name": "vibecheck",
  "version": "0.1.0",
  "description": "Restyle any website with a prompt, using the AI provider you choose.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "vibecheck",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "userScripts"],
  "optional_permissions": ["webNavigation"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://auth.openai.com/*"
  ],
  "optional_host_permissions": ["*://*/*"]
}
